// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Driver {
    id           Int       @id @default(autoincrement())
    driverNumber Int?      @unique @map("driver_number")
    fullName     String    @map("full_name")
    firstName    String?   @map("first_name")
    lastName     String?   @map("last_name")
    nationality  String?
    teamName     String?   @map("team_name")
    birthDate    DateTime? @map("birth_date") @db.Date
    bio          String?
    imageUrl     String?   @map("image_url")
    isActive     Boolean   @default(true) @map("is_active")
    createdAt    DateTime  @default(now()) @map("created_at")
    updatedAt    DateTime  @updatedAt @map("updated_at")

    // Relacionamento com usuários que favoritaram
    favoriteByUsers User[] @relation("FavoriteDriver")

    @@map("drivers")
}

model Team {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    fullName  String?  @map("full_name")
    country   String?
    logoUrl   String?  @map("logo_url")
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    // Relacionamento com usuários que favoritaram
    favoriteByUsers User[] @relation("FavoriteTeam")

    @@map("teams")
}

model User {
    id               String    @id @default(cuid())
    username         String    @unique
    email            String    @unique
    password         String
    name             String
    birthDate        DateTime? @map("birth_date") @db.Date
    favoriteTeamId   Int?      @map("favorite_team_id")
    favoriteDriverId Int?      @map("favorite_driver_id")
    emailVerified    Boolean   @default(false) @map("email_verified")
    isActive         Boolean   @default(true) @map("is_active")
    createdAt        DateTime  @default(now()) @map("created_at")
    updatedAt        DateTime  @updatedAt @map("updated_at")

    // Relacionamentos
    favoriteTeam   Team?   @relation("FavoriteTeam", fields: [favoriteTeamId], references: [id])
    favoriteDriver Driver? @relation("FavoriteDriver", fields: [favoriteDriverId], references: [id])

    @@map("users")
}
