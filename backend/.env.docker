# Database
DATABASE_URL="postgresql://postgres:postgres@database:5432/formulainfo"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD="redis_password"

# Server
PORT=3001
NODE_ENV=development
API_PREFIX="/api/v1"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Logs
LOG_LEVEL="info"
LOG_FILE="logs/app.log"