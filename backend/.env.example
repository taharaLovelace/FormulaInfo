# Database
DATABASE_URL="postgresql://postgres:postgres@database:5432/formulainfo"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# API Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN="http://localhost"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
